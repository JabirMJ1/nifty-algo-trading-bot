KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_URL=postgresql://user:pass@localhost:5432/tradingbot
REDIS_URL=redis://localhost:6379
PAPER_TRADE=true
CAPITAL=100000
MAX_DAILY_LOSS_PCT=2.0
RISK_PER_TRADE_PCT=1.0
INSTRUMENTS=NSE:NIFTY25FEBFUT,MCX:GOLDPETAL25FEBFUT

# News Sentiment (optional — set both keys to enable)
NEWS_API_KEY=
ANTHROPIC_API_KEY=
NEWS_FETCH_INTERVAL_MIN=15
NEWS_SENTIMENT_ENABLED=true

# Historical sentiment for backtesting (free key at alphavantage.co)
ALPHAVANTAGE_API_KEY=

# Options — directional CE/PE buying (set TRADE_OPTIONS=true to enable)
TRADE_OPTIONS=false
OPTIONS_LOT_SIZE=75
OPTIONS_STOP_PCT=50.0
OPTIONS_TARGET_MULT=2.5

# S3 — EOD data archive (optional)
S3_BUCKET=
